er.cmeans(data_T, c=2, m=2.0, error=0.005, maxiter=1000)\n","\n","        # Get target's cluster (highest membership)\n","        target_local_idx = np.where(indices == target_idx)[0][0]\n","        target_cluster = np.argmax(u[:, target_local_idx])\n","\n","        # Get other members of the same cluster above threshold\n","        members = np.where(u[target_cluster] > threshold)[0]\n","\n","        if len(members) == 1 and members[0] == target_local_idx:\n","            #print(f\"Target isolated at depth {depth+1}\")\n","            return indices  # these are the original indices that were clustered in this last step\n","\n","        # Otherwise, reduce to this subset and continue\n","        current_data = current_data[members]\n","        indices = indices[members]\n","\n","    #print(\"Reached max depth without isolating target.\")\n","    return indices"],"metadata":{"id":"bAoi1Ttsl6CY","executionInfo":{"status":"ok","timestamp":1746435382538,"user_tz":-120,"elapsed":5,"user":{"displayName":"Ilya Treyvish","userId":"16890821079739545961"}}},"execution_count":54,"outputs":[]},{"cell_type":"code","source":["def clusterize_family(family_info, embeddings_dict, persons_chosen):\n","  family_members_list = list(family_info.keys())\n","  family_members_embeddings = []\n","  for family_member in family_members_list:\n","    family_member_embeddings = [embeddings_dict[photo]['embedding'] for photo in family_info[family_member] if embeddings_dict[photo] is not None]\n","    family_member_embedding = np.mean(family_member_embeddings, axis=0)\n","    family_member_embedding = normalize_embedding(family_member_embedding)\n","    family_members_embeddings.append(family_member_embedding)\n","    if family_member == persons_chosen:\n","      person_idx = len(family_members_embeddings) - 1\n","  data = np.vstack(family_members_embeddings)\n","  return recursive_fuzzy_isolate(data, person_idx), family_members_list"],"metadata":{"id":"z8MKXxqVitxN","executionInfo":{"status":"o